# MartPOS gateway configuration
# PostgreSQL connection string (required)
DATABASE_URL=postgres://user:pass@host:5432/martpos_gateway

# Public base URL of this gateway - must be https in production (required)
GATEWAY_PUBLIC_URL=https://gateway.example.com

# AES-256-GCM key for encrypting shop access tokens at rest: base64, 32 bytes (required)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GATEWAY_ENCRYPTION_KEY=

# Meta Embedded Signup / Cloud API (required)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Graph API version - defaults to v26.0 when unset
# META_GRAPH_API_VERSION=v26.0

# Only honored when NODE_ENV=test - production always uses https://graph.facebook.com
# META_GRAPH_BASE_URL=http://127.0.0.1:9999

# Optional
# PORT=8080
# GATEWAY_SUPPORT_USERNAME=support
# GATEWAY_SUPPORT_PASSWORD_HASH=   # bcrypt hash of the support password
