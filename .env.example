# Server Configuration
PORT=5000
FLASK_SECRET_KEY=change-this-secret-key-in-production

# Data Directory (optional - defaults to data/ or %LOCALAPPDATA%\MartPOS\)
# MARTPOS_DATA_DIR=/path/to/data

# Google Drive Backup (optional)
# Place credentials.json (OAuth "Desktop app" client) in the data directory,
# then use Settings -> Connect Google Drive. No env vars needed.

# Cloud messaging (optional) - the local POS only ever talks to the MartPOS
# gateway; Meta credentials live on the gateway, never here. This is
# deployment/build-operator configuration - not shop owner input. Packaged
# builds bake it via `npm run build:platform-config`; server-mode deployments
# may set it at runtime instead.
# MARTPOS_CLOUD_URL=https://gateway.example.com

# Required for storing cloud credentials (device token etc.) outside the
# Electron desktop app: base64-encoded 32-byte AES key. Under Electron, DPAPI
# is used instead and this is not needed.
# MARTPOS_SECRET_KEY=

# AI Store Manager (optional)
# Preferred: enter the key once in Settings -> AI Store Manager (stored in the
# encrypted secrets store). This env var is a fallback for server-mode
# deployments. Never put the key in frontend code or commit it to git.
# OPENAI_API_KEY=
# AI model override (default gpt-4o-mini); can also be set in Settings.
# MARTPOS_AI_MODEL=
