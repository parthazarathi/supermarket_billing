# Server Configuration
PORT=5000
FLASK_SECRET_KEY=change-this-secret-key-in-production

# Data Directory (optional - defaults to data/ or %LOCALAPPDATA%\MartPOS\)
# MARTPOS_DATA_DIR=/path/to/data

# Google Drive Backup (optional)
# Place credentials.json (OAuth "Desktop app" client) in the data directory,
# then use Settings -> Connect Google Drive. No env vars needed.

# WhatsApp Integration via Twilio (optional)
# Preferred: enter credentials in Settings -> Cloud & communication (stored
# encrypted in the data dir, never exposed via the API). These env vars are
# only a fallback for legacy server-mode deployments.
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
