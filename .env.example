# Server Configuration
PORT=5000
FLASK_SECRET_KEY=change-this-secret-key-in-production

# Data Directory (optional - defaults to data/ or %LOCALAPPDATA%\MartPOS\)
# MARTPOS_DATA_DIR=/path/to/data

# Google Drive Backup (optional)
# Place credentials.json in the data directory instead of using env vars

# WhatsApp Integration via Twilio (optional)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886