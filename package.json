{
  "name": "mart-pos",
  "version": "1.0.0",
  "description": "Vyapar-style billing application - migrated from Python to Node.js",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "desktop": "node desktop.js",
    "build": "pkg . --targets node18-win-x64 --output dist/MartPOS.exe",
    "build:installer": "npm run build && node build-installer.js",
    "lint": "eslint ."
  },
  "keywords": [
    "pos",
    "billing",
    "inventory",
    "supermarket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "google-auth-library": "^9.0.0",
    "googleapis": "^128.0.0",
    "helmet": "^8.3.0",
    "open": "^8.4.2",
    "pdfkit": "^0.13.0",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.3",
    "sql.js": "^1.10.3",
    "twilio": "^4.19.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "innosetup-compiler": "^6.3.1",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "templates/**/*",
      "data/products.json",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/pdfkit/js/data/**/*"
    ],
    "scripts": [
      "node_modules/es-get-iterator/**/*.js"
    ]
  }
}
